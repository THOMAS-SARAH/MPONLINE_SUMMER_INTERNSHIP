@model IEnumerable<StudentRegistrationWebApp.Models.StudentProfile>

@{
    ViewData["Title"] = "Student Profiles";
}

<h2>Student Profiles</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Student
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Address</th>
            <th>Phone</th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.FullName</td>
            <td>@item.Address</td>
            <td>@item.Phone</td>
        </tr>
}
    </tbody>
</table>